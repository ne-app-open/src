{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": [
    "../",
    "./",
    "../../src/kernel",
    "../../src/kernel/src"
  ],
  "sources_path": [
    "src/*.cpp"
  ],
  "output_name": "./dist/libUI.fwrk.dylib",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "kNUIVersion=0x0100",
    "kNUIVersionHighest=0x0100",
    "kNUIVersionLowest=0x0100"
  ]
}