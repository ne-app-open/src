{
    "compiler_path": "x86_64-w64-mingw32-g++",
    "compiler_std": "c++20",
    "headers_path": ["../", "./", "../src/kernel/src/", "../src/kernel/src/kernel"],
    "sources_path": ["src/*.cc"],
    "output_name": "./dist/x11.ddk.out",
    "compiler_flags": [
      "-ffreestanding",
      "-shared",
      "-fno-rtti",
      "-fno-exceptions",
      "-Wl,--subsystem=17"
    ],
    "ddk_depends_on": [
      "GPUBasic"
    ],
    "cpp_macros": [
      "kX11Version=0x0100",
      "kX11VersionHighest=0x0100",
      "kX11VersionLowest=0x0100"
    ]
  }
  
