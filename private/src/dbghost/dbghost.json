{
  "compiler_path": "x86_64-w64-mingw32-gcc",
  "compiler_std": "c++20",
  "headers_path": [ "../", "./", "../../../public/" ],
  "sources_path": [ "src/*.cpp" ],
  "output_name": "./dist/dbghost.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "kNeDbgVersion=0x0100",
    "kNeDbgVersionHighest=0x0100",
    "kNeDbgVersionLowest=0x0100"
  ],
  "description": "The NeSystem Debug Host Service."
}
  
