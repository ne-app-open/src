{
  "compiler_path": "x86_64-w64-mingw32-gcc",
  "compiler_std": "c++20",
  "headers_path": [ "../", "./", "../../../public/" ],
  "sources_path": [ "src/*.cpp" ],
  "output_name": "./dist/posixsrv.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "kNePsxVersion=0x0100",
    "kNePsxVersionHighest=0x0100",
    "kNePsxVersionLowest=0x0100"
  ],
  "description": "The Ne.app NeSystem POSIX Server."
}
  
