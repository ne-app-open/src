{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": [ "../", "./", "../../../public/" ],
  "sources_path": [ "src/*.c" ],
  "output_name": "./dist/nehost.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "kNeVersion=0x0100",
    "kNeVersionHighest=0x0100",
    "kNeVersionLowest=0x0100"
  ],
  "description": "The NeSystem Common Host Service."
}
  
